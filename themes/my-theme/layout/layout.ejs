<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- 基础 SEO -->
    <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
    <meta name="description" content="<%= page.excerpt ? strip_html(page.excerpt).substring(0, 100) : config.description %>">
    <meta name="keywords" content="<%= config.keywords || '' %>">

    <!-- Open Graph 社交分享标签 -->
    <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
    <meta property="og:title" content="<%= page.title ? page.title : config.title %>">
    <meta property="og:url" content="<%- config.url + url_for(page.path) %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:description" content="<%= page.excerpt ? strip_html(page.excerpt).substring(0, 100) : config.description %>">

    <!-- 代码高亮 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <!-- RSS 订阅 -->
    <link rel="alternate" type="application/atom+xml" href="<%- url_for('/atom.xml') %>" title="<%= config.title %>">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <a href="#main-content" class="skip-link">跳转到主要内容</a>

    <header role="banner">
        <div class="header-top">
            <h1><a href="/" style="color: inherit; text-decoration: none;"><%= config.title %></a></h1>
            <div class="header-buttons">
                <button id="theme-toggle" class="theme-btn" aria-label="切换暗色模式">🌙</button>
                <button id="mobile-menu-toggle" class="menu-btn" aria-label="切换菜单">☰</button>
            </div>
        </div>
        <nav class="main-nav" role="navigation" aria-label="主导航">
            <a href="/">首页</a>
            <a href="/archives">归档</a>
            <a href="/categories">分类</a>
            <a href="/tags">标签</a>
            <a href="/search">搜索</a>
        </nav>
    </header>

    <main id="main-content" role="main">
        <%- body %>
    </main>

    <footer role="contentinfo">
        <p>&copy; <%= new Date().getFullYear() %> <%= config.author %>. All rights reserved.</p>
        <p style="margin-top: 0.5rem; font-size: 0.8rem;">
            Powered by <a href="https://hexo.io" target="_blank">Hexo</a> | <a href="/atom.xml">RSS</a>
        </p>
    </footer>
    <script src="/js/main.js"></script>
</body>
</html>
