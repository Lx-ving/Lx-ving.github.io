<article class="post">
  <header class="post-header">
    <h1><%= page.title %></h1>
    <time><%= date(page.date, 'YYYY-MM-DD') %></time>
  </header>
  <div class="post-content">
    <%- page.content %>
  </div>
</article>

<nav class="post-nav">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev.path) %>" class="post-nav-prev">&larr; <%= page.prev.title %></a>
  <% } %>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next.path) %>" class="post-nav-next"><%= page.next.title %> &rarr;</a>
  <% } %>
</nav>
