<article class="post">
  <header class="post-header">
    <h1><%= page.title %></h1>
    <time><%= date(page.date, 'YYYY-MM-DD') %></time>
  </header>
  
  <div class="post-body">
    <% if (page.toc !== false) { %>
      <aside class="post-toc">
        <h3>目录</h3>
        <%- toc(page.content) %>
      </aside>
    <% } %>
    <div class="post-content">
      <%- page.content %>
    </div>
  </div>
</article>

<nav class="post-nav">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev.path) %>" class="post-nav-prev">&larr; <%= page.prev.title %></a>
  <% } %>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next.path) %>" class="post-nav-next"><%= page.next.title %> &rarr;</a>
  <% } %>
</nav>
